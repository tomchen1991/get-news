# Copy to .dev.vars (gitignored). Never commit real values.
# Current production entry: src/site/index.ts. No ADMIN_TOKEN or push credentials.
SEARCH_ENABLED=false
JEV_ENABLED=false
TAVILY_API_KEY=
AI_GATEWAY_ID=replace-with-your-gateway-id
NEWS_TIMEZONE=Asia/Shanghai
NEWS_MORNING_HOUR=7
TAVILY_DAILY_CREDITS=36
TAVILY_MONTHLY_CREDITS=950
JEV_DAILY_REQUESTS=360
JEV_MONTHLY_REQUESTS=10000
# Optional Chinese digest, one immutable issue daily at 09:00 local time.
DIGEST_ENABLED=false
DIGEST_MODEL=
DIGEST_HOUR=9
DIGEST_MONTHLY_REQUESTS=31
# Optional push-event capture only; no transport or actual delivery exists yet.
# Apply migration 0014 first. Set an explicit UTC activation instant to avoid backfill.
PUSH_EVENTS_ENABLED=false
PUSH_EVENTS_SINCE=
# Optional Worker agent presence, NOT PI. Dedicated producer scope required.
# HTTPS endpoint must be exactly /ingest/agent_presence/1. Never reuse PI tokens.
WORKER_PRESENCE_ENABLED=false
WORKER_PRESENCE_URL=
WORKER_PRESENCE_SOURCE_ID=
WORKER_PRESENCE_TOKEN=
# Optional owner-only writes. Protect /api/feedback* with Access (including login/session).
FEEDBACK_ENABLED=false
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
FEEDBACK_ALLOWED_EMAILS=
# AI binding is remote: enabling Jev even in wrangler dev can incur charges.
# Jev uses the AI binding + Gateway billing; no model API key is read here.
# Optional legacy local TUI /plan only; never used by the production news site.
LLM_BASE_URL=https://api.your-provider.com/v1
LLM_MODEL=replace-with-an-explicit-model-id
LLM_API_KEY=
