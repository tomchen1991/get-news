# Copy to .dev.vars (gitignored). Do not commit real values.
ADMIN_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# Enable only after choosing the provider, model and spending budget.
LLM_ENABLED=false
LLM_BASE_URL=https://api.your-provider.com/v1
LLM_MODEL=replace-with-an-explicit-model-id
LLM_API_KEY=
# Generic JSON webhook, not an assumed Telegram/WeCom format.
PUSH_ENABLED=false
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
# Optional conversational-agent credential: restricted to this user's profile APIs.
# Never give ADMIN_TOKEN to the news judge or conversational agent.
PROFILE_AGENT_TOKEN=
PROFILE_AGENT_USER_ID=owner
# Search is opt-in; enabling transmits explicit interest/topic labels to chosen provider.
SEARCH_ENABLED=false
SEARCH_PROVIDER=tavily
SEARCH_TIMEZONE=Asia/Shanghai
TAVILY_API_KEY=
TAVILY_DAILY_CREDITS=29
TAVILY_MONTHLY_CREDITS=900
# Alternative (not invoked alongside Tavily): paid CF Ceramic Web Search.
CF_ACCOUNT_ID=
CF_SEARCH_API_TOKEN=
CF_SEARCH_GATEWAY_ID=
CF_SEARCH_DAILY_REQUESTS=29
CF_SEARCH_MONTHLY_REQUESTS=900
